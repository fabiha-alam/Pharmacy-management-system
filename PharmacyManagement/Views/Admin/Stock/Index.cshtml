@model IEnumerable<PharmacyManagement.Models.ViewModels.Stock.StockViewModel>

@{
    ViewData["Title"] = "Manage Stocks";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Stocks</h1>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fas fa-table me-1"></i> Stock Inventory</div>
            <a asp-action="AddStock" class="btn btn-primary btn-sm">Add Stock</a>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 10%;">BATCH</th>
                        <th class="text-center" style="width: 20%;">MEDICINE</th>
                        <th class="text-center" style="width: 12%;">QUANTITY</th>
                        <th class="text-center" style="width: 12%;">PURCHASE PRICE</th>
                        <th class="text-center" style="width: 12%;">SELLING PRICE</th>
                        <th class="text-center" style="width: 11%;">EXPIRY DATE</th>
                        <th class="text-center" style="width: 12%;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.BatchNumber</td>
                            <td class="text-center">@item.MedicineName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-center">BDT @item.PurchasePrice.ToString("0.00")</td>
                            <td class="text-center">BDT @item.SellingPrice.ToString("0.00")</td>
                            <td class="text-center">@item.ExpiryDate.ToShortDateString()</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="EditStock" asp-route-id="@item.StockId" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-action="DeleteStock" asp-route-id="@item.StockId" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>