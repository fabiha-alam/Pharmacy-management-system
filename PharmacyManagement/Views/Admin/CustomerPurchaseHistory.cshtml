@model PharmacyManagement.Models.ViewModels.Admin.CustomerPurchaseHistoryAdminViewModel

<div class="p-2">
    <h5 class="mb-3">Purchase History for <strong>@Model.CustomerName</strong></h5>

    @if (Model.Purchases != null && Model.Purchases.Any())
    {
        @foreach (var purchase in Model.Purchases)
        {
            <div class="card mb-3 border-secondary">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span><strong>Order ID:</strong> #@purchase.PurchaseId</span>
                    <span><strong>Date:</strong> @purchase.PurchaseDate.ToString("yyyy-MM-dd HH:mm")</span>
                    <span class="badge bg-success fs-6">Total: @purchase.TotalAmount.ToString("C")</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Medicine</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in purchase.PurchaseItems)
                            {
                                <tr>
                                    <td>@item.MedicineName</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td>@item.TotalPrice.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center mb-0" role="alert">
            No purchase history found for this customer.
        </div>
    }
</div>