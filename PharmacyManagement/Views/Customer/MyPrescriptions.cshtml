@model IEnumerable<PharmacyManagement.Models.ViewModels.Prescription.PrescriptionViewModel>

@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">My Prescriptions</h2>
    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill me-2">Back to Purchases</a>
        <a asp-controller="Customer" asp-action="UploadPrescription" class="btn btn-primary rounded-pill">Upload New</a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>AI Detected Medicines & Stock Status</th>
                        <th>Notes</th>
                        <th>Status</th>
                        <th>Uploaded At</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <!-- Trigger Document Modal -->
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#docModal-@item.PrescriptionId">
                                        <i class="bi bi-file-earmark-text me-1"></i> View Document
                                    </button>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ExtractedMedicines))
                                    {
                                        <div class="p-3 bg-light rounded-3 border small text-dark mb-2">
                                            <div class="fw-bold text-primary mb-1"><i class="bi bi-cpu me-1"></i> AI Analysis Result:</div>
                                            <p class="mb-2">@item.ExtractedMedicines</p>
                                        </div>

                                        <!-- Stock & Buy Integration using MatchedItems -->
                                        @if (item.MatchedItems != null && item.MatchedItems.Any())
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var med in item.MatchedItems)
                                                {
                                                    <div class="p-2 border rounded bg-white shadow-sm d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <strong>@med.MedicineName</strong>
                                                            @if (!string.IsNullOrEmpty(med.Dosage))
                                                            {
                                                                <small class="text-muted d-block">Dosage: @med.Dosage</small>
                                                            }

                                                            @if (med.IsAvailable)
                                                            {
                                                                <span class="badge bg-success mt-1">In Stock (@med.StockQuantity available) - $@med.SellingPrice.ToString("0.00")</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-danger mt-1">Out of Stock</span>
                                                            }
                                                        </div>
                                                        <div>
                                                            @if (med.IsAvailable && med.MedicineId != null)
                                                            {
                                                                <a asp-controller="Customer" asp-action="Checkout"
                                                                   asp-route-medicineId="@med.MedicineId"
                                                                   asp-route-quantity="1"
                                                                   class="btn btn-sm btn-primary rounded-pill px-3">
                                                                    Buy Now
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>Unavailable</button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">No matching catalog items found for instant purchase.</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Pending scan...</span>
                                    }
                                </td>
                                <td>@item.Notes</td>
                                <td>
                                    @if (item.Status == "All Available")
                                    {
                                        <span class="badge bg-success">All Available</span>
                                    }
                                    else if (item.Status == "Partially Available")
                                    {
                                        <span class="badge bg-warning text-dark">Partially Available</span>
                                    }
                                    else if (item.Status == "Out of Stock" || item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>@item.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No prescriptions found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Document Modals Rendered Outside Table -->
@if (Model != null && Model.Any())
{
    @foreach (var item in Model)
    {
        <div class="modal fade" id="docModal-@item.PrescriptionId" tabindex="-1" aria-labelledby="docModalLabel-@item.PrescriptionId" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold" id="docModalLabel-@item.PrescriptionId">Prescription Document #@item.PrescriptionId</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4 bg-white text-center">
                        @if (!string.IsNullOrEmpty(item.FileUrl))
                        {
                            @if (item.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="ratio ratio-16x9">
                                    <iframe src="@item.FileUrl" class="rounded-3 border" title="Prescription PDF"></iframe>
                                </div>
                            }
                            else
                            {
                                <img src="@item.FileUrl" alt="Prescription Document" class="img-fluid rounded-3 shadow-sm" style="max-height: 500px; object-fit: contain;" />
                            }
                        }
                        else
                        {
                            <p class="text-muted py-4">No document file available.</p>
                        }
                    </div>
                    <div class="modal-footer bg-light justify-content-between">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                        @if (!string.IsNullOrEmpty(item.FileUrl))
                        {
                            <a href="@item.FileUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Open in New Tab
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}